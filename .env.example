# GitHub Personal Access Token (requires repo scope for reading PRs and committing refactored code)
GITHUB_TOKEN=ghp_your_github_token_here

# Optional webhook secret for verifying X-Hub-Signature-256 headers from GitHub
GITHUB_WEBHOOK_SECRET=

# OpenAI API Key for LLM-powered code refactoring via LangChain
OPENAI_API_KEY=sk-your_openai_api_key_here

# LLM Configuration
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Persistence Checkpointer Configuration ("sqlite" or "memory")
CHECKPOINTER_TYPE=sqlite
SQLITE_DB_PATH=data/review_checkpoints.sqlite

# Sandbox Execution Configuration
LINTER_TIMEOUT_SECONDS=15
ENABLE_BLACK_CHECK=true
ENABLE_FLAKE8_CHECK=true

# Execution Mode ("false" for real GitHub/OpenAI calls, "true" to dry-run commits when credentials are absent)
DRY_RUN_MODE=true

# Server Configuration
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
